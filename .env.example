# Supabase (URL은 /rest/v1 없이 프로젝트 루트 URL만)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=

# OpenAI (STEP 9)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Embedding (BGE-M3): auto | cuda | cpu
EMBEDDING_DEVICE=auto
EMBEDDING_BATCH_SIZE=16

# Retrieval: v1 (body-only) | v2 (breadcrumb context)
RETRIEVAL_EMBED_VERSION=v2
